{
  "type": "object",
  "properties": {
    "contract": {
      "const": "opencode-plugin-classifier"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "pre_tool_call",
        "post_tool_call"
      ]
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "enum": [
            "allow",
            "deny"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract",
    "contract_version",
    "request_id",
    "phase",
    "binding_digest",
    "status",
    "decision",
    "reason",
    "evidence_paths",
    "error"
  ],
  "additionalProperties": false,
  "description": "Classifier response or locally normalized transport failure. evidence_paths are RFC 6901 pointers into this request. Plugin verifies request_id/phase/digest against the waiting immutable checkpoint. No classifier-provided shell commands or arbitrary execution instructions.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "deny"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
