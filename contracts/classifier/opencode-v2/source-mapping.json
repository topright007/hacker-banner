{
  "version": "2.0.22",
  "provenance": "Official npm declarations plus pinned upstream source. Live runtime validation is separate.",
  "sources": [
    {
      "path": "/current_call",
      "api": "ctx.tool.hook execute.before/execute.after",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/plugin/src/promise/tool.ts"
    },
    {
      "path": "/context/model_context",
      "api": "ctx.session.hook context/compaction/generate/title/model.request/http.request/http.response/experimental.ws.*",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/plugin/src/promise/session.ts"
    },
    {
      "path": "/context/sessions",
      "api": "ctx.session.get/context and independently retained observations",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/schema/src/session.ts"
    },
    {
      "path": "/context/sessions/*/observed_messages",
      "api": "Native Session.Message.Info projections, latest observed value per ID",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/schema/src/session-message.ts"
    },
    {
      "path": "/context/tool_catalog",
      "api": "ctx.tool.list, Effect JSON Schema conversion, native JSON schemas",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/schema/src/tool.ts"
    },
    {
      "path": "/context/runtime_configuration",
      "api": "ctx.agent/model/provider/mcp/plugin/command/skill/reference.list projections",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/plugin/src/promise/plugin.ts"
    },
    {
      "path": "/context/journal/permission_evaluations",
      "api": "ctx.permission.hook evaluate",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/plugin/src/promise/permission.ts"
    },
    {
      "path": "/context/journal/events",
      "api": "ctx.event.subscribe scoped session/permission events since attachment",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/plugin/src/promise/event.ts"
    },
    {
      "path": "/context/workspace",
      "api": "ctx.location, ctx.vcs.get/status/base, ctx.worktree.list",
      "source": "https://github.com/anomalyco/opencode/blob/v2.0.22/packages/plugin/src/promise/vcs.ts"
    }
  ],
  "package_tarballs": [
    "https://registry.npmjs.org/@opencode/plugin/-/plugin-2.0.22.tgz",
    "https://registry.npmjs.org/@opencode/client/-/client-2.0.22.tgz",
    "https://registry.npmjs.org/@opencode/schema/-/schema-2.0.22.tgz"
  ]
}
